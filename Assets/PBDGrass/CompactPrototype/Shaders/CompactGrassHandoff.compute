// Generated storage variant; equations come from the accepted source.
// Regenerate with CompactPrototype/Editor/generate_compact_shaders.py.
// Experimental bounded history path. The response/ground/plastic equations below are
// copied from the accepted GrassHandoff.compute; the baseline asset remains unchanged.
#pragma kernel ResetGeometry
#pragma kernel InitializeHistory
#pragma kernel InitializeNearHistory COMPACT_NEAR_BIRTH
#pragma kernel CaptureTransition
#pragma kernel SeedSimulation
#pragma kernel UpdateTieredDisplay
#pragma kernel AdvanceBakedWind
#pragma kernel DiagnosticSnapshot
#pragma kernel ResetWorldWind
#pragma kernel ResetWorldGeometry
#define NODES 8
#define SEGMENTS 7
// Layouts match GrassBladeData and PBDSolverCS. All positions below are blade-root relative.
struct BoneInfo { float3 Position, Predicted, Velocities, OriginPos; };
struct Blade { float3 Root; float Length; uint Id; float Width, Height, Seed; };
struct Rod { float4 Rotation, Relative; float Length, HalfWidth, InverseInertia, SoftScale; float HardScale, TwistScale, Padding0, Padding1; };
struct Frame { float4 Rotation; float3 AngularVelocity; float Padding; };
struct GridState { int PoolOffset, Changed; float Started, Padding; };
float ContactFadeSeconds;
struct ActiveGrid { float3 Position; int BladeOffset,PoolOffset,GridId,Padding0,Padding1; };
StructuredBuffer<Blade> BladesBuffer;
StructuredBuffer<Rod> RodsBuffer;
StructuredBuffer<BoneInfo> RestNodesBuffer;

RWStructuredBuffer<float4> PlasticBendsBuffer;
StructuredBuffer<uint> CompactPlastic;
#define COMPACT_POSE_WRITABLE
#include "GrassCompactPacking.cginc"
float4 CompactBend(uint index) { return float4(CompactUnpackPlastic(CompactPlastic[(index/7)*8+index%7]),0,0); }

StructuredBuffer<GridState> GridStates;
StructuredBuffer<int2> Entries;
StructuredBuffer<ActiveGrid> BakedGrids;
StructuredBuffer<float4> BakedControls,BakedFrames,BakedYaw;
RWStructuredBuffer<float4> BakedWindState;
StructuredBuffer<float4> BakedWindRead, BakedWindPrevious;
RWStructuredBuffer<float4> PreviousWindState;
StructuredBuffer<int2> HistoryMap, ChangedEntries;
StructuredBuffer<int4> HistoryInitializations;
RWStructuredBuffer<BoneInfo> DiagnosticNodes;
RWStructuredBuffer<Frame> DiagnosticFrames;
int HistoryInitializationCount, ChangedCount;
StructuredBuffer<int> RecycledGrids;
int RecycledCount;
StructuredBuffer<float> BakedInverseMass;
float3 BakedGravity;
float BakedBladeMass;
float LodgedAngularSpeed;
float4 BakedMomentCompliance[7];
RWStructuredBuffer<BoneInfo> BonesBuffer, HistoryNodes;
RWStructuredBuffer<Frame> FramesBuffer, HistoryFrames;
RWStructuredBuffer<float3> TransitionOffsets;
RWStructuredBuffer<float4> TransitionRotations;
RWStructuredBuffer<float3> ResultPosBuffer, NormalBuffer;
StructuredBuffer<BoneInfo> CompactBonesRead;
StructuredBuffer<Frame> CompactFramesRead;
StructuredBuffer<float3> CompactOffsetsRead;
StructuredBuffer<float4> CompactRotationsRead;
Texture2D<float4> WindForceMap;
SamplerState sampler_linear_repeat;
int BladeCount, EntryCount, EnablePlasticity, GroundCollision;
int EnableBakedResponse,GridCount;
float4 BakedDynamics;
float BakedMaxWind;
float PoseTime, PoseDt, TransitionSeconds, WindDisplacement, WindFrequency, CollisionMargin;
float3 WindForce;
float4 WindTileOffset;
float3 SafeNormal(float3 v,float3 fallback) { float l=dot(v,v); return l>1e-16?v*rsqrt(l):fallback; }
float4 QMul(float4 a,float4 b) { return float4(a.w*b.xyz+b.w*a.xyz+cross(a.xyz,b.xyz),a.w*b.w-dot(a.xyz,b.xyz)); }
float4 QInv(float4 q) { return float4(-q.xyz,q.w); }
float3 QRotate(float4 q,float3 v) { return v+2*cross(q.xyz,cross(q.xyz,v)+q.w*v); }
float4 QNormalize(float4 q) { return q*rsqrt(max(dot(q,q),1e-8)); }
float4 QExp(float3 v)
{ float a=length(v); return QNormalize(float4(v*(a>1e-6?sin(a*.5)/max(a,1e-6):.5),cos(a*.5))); }
float3 QLog(float4 q)
{ if(q.w<0)q=-q; float l=length(q.xyz); return q.xyz*(l>1e-6?2*atan2(l,q.w)/max(l,1e-6):2); }
float4 QBlend(float4 a,float4 b,float t) { if(dot(a,b)<0)b=-b; return QNormalize(lerp(a,b,t)); }
#include "GrassCompactTemplates.cginc"
float4 AlignTangent(float4 q,float3 tangent)
{
    float3 old=QRotate(q,float3(0,0,1)); float d=dot(old,tangent);
    float4 delta=d<-.9999?float4(QRotate(q,float3(1,0,0)),0):QNormalize(float4(cross(old,tangent),1+d));
    return QNormalize(QMul(delta,q));
}
float3 SpatialWind(float3 root,float time)
{
    float2 scroll=SafeNormal(float3(WindForce.x,0,WindForce.z),float3(1,0,0)).xz;
    float2 uv=root.xz*WindTileOffset.xy+WindTileOffset.zw+scroll*WindFrequency*time;
    float2 noise=WindForceMap.SampleLevel(sampler_linear_repeat,uv,0).rg;
    return WindForce*lerp(.55,1.45,noise.x)+cross(float3(0,1,0),WindForce)*(noise.y*2-1)*.2;
}
[numthreads(64,1,1)]
void AdvanceBakedWind(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=(uint)GridCount)return;
    float3 wind=QRotate(QInv(BakedYaw[id.x]),SpatialWind(BakedGrids[id.x].Position,PoseTime));
    float4 state=BakedWindState[id.x]; PreviousWindState[id.x]=state; float2 q=state.xy,v=state.zw;
    [unroll] for(int s=0;s<8;s++)
    {
        float h=PoseDt/8;
        v+=(-2*BakedDynamics.zw*BakedDynamics.xy*v-BakedDynamics.xy*BakedDynamics.xy*(q-wind.xz))*h;
        q+=v*h;
    }
    BakedWindState[id.x]=float4(q,v);
}
float3 ResponseControl(uint control,int2 cell,float2 f)
{
    uint index=(cell.y*5+cell.x)*3+control;
    return lerp(lerp(BakedControls[index].xyz,BakedControls[index+3].xyz,f.x),
        lerp(BakedControls[index+15].xyz,BakedControls[index+18].xyz,f.x),f.y);
}
float4 ResponseFrame(uint segment,int2 cell,float2 f)
{
    uint index=(cell.y*5+cell.x)*7+segment;
    return QBlend(QBlend(BakedFrames[index],BakedFrames[index+7],f.x),QBlend(BakedFrames[index+35],BakedFrames[index+42],f.x),f.y);
}
float3 GroundDirection(float3 start,float3 direction,float segmentLength)
{
    if(GroundCollision!=0 && start.y+direction.y*segmentLength<CollisionMargin)
    {
        float dy=clamp((CollisionMargin-start.y)/max(segmentLength,1e-6),-1,1);
        direction=SafeNormal(float3(direction.x,0,direction.z),float3(1,0,0))*sqrt(max(0,1-dy*dy))+float3(0,dy,0);
    }
    return direction;
}
void EvaluateBaked(uint blade,bool previous,out float3 p[NODES],out float4 q[SEGMENTS])
{
    uint grid=blade/32;
    float4 yaw=BakedYaw[grid];
    float2 responseWind=previous?BakedWindPrevious[grid].xy:BakedWindRead[grid].xy;
    float2 uv=(clamp(responseWind/max(BakedMaxWind,.01),-1,1)+1)*2;
    int2 cell=min((int2)floor(uv),3); float2 f=uv-cell;
    float3 c1=QRotate(yaw,ResponseControl(0,cell,f)),c2=QRotate(yaw,ResponseControl(1,cell,f)),tip=QRotate(yaw,ResponseControl(2,cell,f));
    float4 baseFrames[7]; float arc=0,total=BladesBuffer[blade].Length;
    p[0]=0;
    [unroll] for(int s=0;s<7;s++)
    {
        Rod rod=CompactRod(blade*7+s); arc+=rod.Length; float t=arc/max(total,1e-6),u=1-t;
        float3 samplePosition=3*u*u*t*c1+3*u*t*t*c2+t*t*t*tip;
        float3 direction=GroundDirection(p[s],SafeNormal(samplePosition-p[s],float3(0,1,0)),rod.Length);
        p[s+1]=p[s]+direction*rod.Length;
        baseFrames[s]=AlignTangent(QMul(yaw,ResponseFrame(s,cell,f)),direction);
    }
    // Precomputed curves describe intact elastic load response. Permanent bend is composed in
    // parent material coordinates, independent of simulation slot and grid wind history.
    float4 anchor=CompactRod(blade*7).Rotation;
    float2 basal=EnablePlasticity!=0?CompactBend(blade*7).xy:float2(0,0);
    q[0]=QNormalize(QMul(anchor,QMul(QExp(float3(basal,0)),QMul(QInv(anchor),baseFrames[0]))));
    p[1]=GroundDirection(0,QRotate(q[0],float3(0,0,1)),CompactRod(blade*7).Length)*CompactRod(blade*7).Length;
    q[0]=AlignTangent(q[0],SafeNormal(p[1],float3(0,1,0)));
    [unroll] for(int joint=1;joint<7;joint++)
    {
        float2 plastic=EnablePlasticity!=0?CompactBend(blade*7+joint).xy:float2(0,0);
        float4 relative=QMul(QInv(baseFrames[joint-1]),baseFrames[joint]);
        q[joint]=QNormalize(QMul(q[joint-1],QMul(QExp(float3(plastic,0)),relative)));
        float len=CompactRod(blade*7+joint).Length;
        float3 direction=GroundDirection(p[joint],QRotate(q[joint],float3(0,0,1)),len);
        p[joint+1]=p[joint]+direction*len; q[joint]=AlignTangent(q[joint],direction);
    }
    float plasticAmount=0;
    if(EnablePlasticity!=0) [unroll] for(int inspect=0;inspect<7;inspect++)plasticAmount+=dot(CompactBend(blade*7+inspect).xy,CompactBend(blade*7+inspect).xy);
    if(plasticAmount<1e-8)return;
    // A lodged rest curve changes gravity's lever arms. Correct the intact response using
    // an algebraic beam-moment model; no far-field integration, XPBD constraints, or plastic flow.
    // The reference term makes the correction zero for the intact baked response.
    float3 referenceNodes[8],referenceMoment[7],bakedElastic[7],elastic[7];
    referenceNodes[0]=0;
    [unroll] for(int reference=0;reference<7;reference++)
        referenceNodes[reference+1]=referenceNodes[reference]+QRotate(baseFrames[reference],float3(0,0,CompactRod(blade*7+reference).Length));
    float4 referenceParent=anchor;
    float3 filteredWind=QRotate(yaw,float3(responseWind.x,0,responseWind.y));
    [unroll] for(int r=0;r<7;r++)
    {
        float3 moment=0;
        [unroll] for(int node=r+1;node<8;node++)
        {
            float height=node/7.0, mass=BakedBladeMass/max(BakedInverseMass[(blade*8+node)%8],1e-8);
            moment+=cross(referenceNodes[node]-referenceNodes[r],mass*(BakedGravity+filteredWind*height*height));
        }
        referenceMoment[r]=QRotate(QInv(referenceParent),moment);
        bakedElastic[r]=QLog(QMul(QMul(QInv(referenceParent),baseFrames[r]),QInv(CompactRod(blade*7+r).Relative)));
        elastic[r]=bakedElastic[r]; referenceParent=baseFrames[r];
    }
    [loop] for(int iteration=0;iteration<24;iteration++)
    {
        float4 previousParent=anchor;
        [unroll] for(int r=0;r<7;r++)
        {
            float3 moment=0;
            [unroll] for(int node=r+1;node<8;node++)
            {
                float height=node/7.0,mass=BakedBladeMass/max(BakedInverseMass[(blade*8+node)%8],1e-8);
                moment+=cross(p[node]-p[r],mass*(BakedGravity+filteredWind*height*height));
            }
            float2 compliance=BakedMomentCompliance[r].xy;
            float2 target=asin(clamp(sin(bakedElastic[r].xy)+compliance*(QRotate(QInv(previousParent),moment).xy-referenceMoment[r].xy),-.95,.95));
            target=clamp(target,-1.2,1.2);
            elastic[r].xy=lerp(elastic[r].xy,target,.2); previousParent=q[r];
        }
        float4 parentFrame=anchor; p[0]=0;
        [unroll] for(int rebuild=0;rebuild<7;rebuild++)
        {
            Rod rod=CompactRod(blade*7+rebuild); float2 plastic=CompactBend(blade*7+rebuild).xy;
            float4 relative=QMul(QExp(elastic[rebuild]),QMul(QExp(float3(plastic,0)),rod.Relative));
            q[rebuild]=QNormalize(QMul(parentFrame,relative));
            float3 direction=GroundDirection(p[rebuild],QRotate(q[rebuild],float3(0,0,1)),rod.Length);
            p[rebuild+1]=p[rebuild]+direction*rod.Length; q[rebuild]=AlignTangent(q[rebuild],direction); parentFrame=q[rebuild];
        }
    }
}
void EvaluateCurve(uint blade,float time,bool previous,out float3 p[NODES],out float4 q[SEGMENTS])
{
    if(EnableBakedResponse!=0) { EvaluateBaked(blade,previous,p,q); return; }
    // Build the material's permanent rest skeleton, then least-squares fit ONE cubic Bezier.
    // Root/tip are fixed; the two interior controls minimize error at the original arc samples.
    p[0]=0; float4 parent=CompactRod(blade*7).Rotation;
    [unroll] for(int s=0;s<7;s++)
    {
        Rod r=CompactRod(blade*7+s);
        float2 plastic=EnablePlasticity!=0?CompactBend(blade*7+s).xy:float2(0,0);
        q[s]=QNormalize(QMul(parent,QMul(QExp(float3(plastic,0)),r.Relative)));
        p[s+1]=p[s]+QRotate(q[s],float3(0,0,r.Length)); parent=q[s];
    }
    float3 tip=p[7],rhs1=0,rhs2=0;
    float aa=0,ab=0,bb=0,arc=0,total=BladesBuffer[blade].Length;
    [unroll] for(int n=1;n<7;n++)
    {
        arc+=CompactRod(blade*7+n-1).Length;
        float t=arc/max(total,1e-6),u=1-t,a=3*u*u*t,b=3*u*t*t;
        float3 residual=p[n]-t*t*t*tip;
        aa+=a*a; ab+=a*b; bb+=b*b; rhs1+=a*residual; rhs2+=b*residual;
    }
    float det=max(aa*bb-ab*ab,1e-8);
    float3 c1=(bb*rhs1-ab*rhs2)/det,c2=(aa*rhs2-ab*rhs1)/det;
    float3 root=BladesBuffer[blade].Root;
    float2 scroll=SafeNormal(float3(WindForce.x,0,WindForce.z),float3(1,0,0)).xz;
    float2 uv=root.xz*WindTileOffset.xy+WindTileOffset.zw+scroll*WindFrequency*time;
    float2 noise=WindForceMap.SampleLevel(sampler_linear_repeat,uv,0).rg;
    float3 wind=WindForce*lerp(.55,1.45,noise.x)+cross(float3(0,1,0),WindForce)*(noise.y*2-1)*.2;
    // Shared spatial wind field, authored Bezier displacement; this is not another XPBD solve.
    float wave=.75+.25*sin(time*2.1+root.x*.4+root.z*.27);
    float3 displacement=wind*WindDisplacement*wave;
    c1+=displacement*.08; c2+=displacement*.55; tip+=displacement;
    arc=0;
    [unroll] for(int j=0;j<7;j++)
    {
        Rod r=CompactRod(blade*7+j); arc+=r.Length;
        float t=arc/max(total,1e-6),u=1-t;
        float3 sample=3*u*u*t*c1+3*u*t*t*c2+t*t*t*tip;
        // Arc projection gives the incoming physical chain its exact segment lengths.
        float3 direction=SafeNormal(sample-p[j],QRotate(q[j],float3(0,0,1)));
        if(GroundCollision!=0 && p[j].y+direction.y*r.Length<CollisionMargin)
        {
            float dy=clamp((CollisionMargin-p[j].y)/max(r.Length,1e-6),-1,1);
            float3 horizontal=SafeNormal(float3(direction.x,0,direction.z),float3(1,0,0));
            direction=horizontal*sqrt(max(0,1-dy*dy))+float3(0,dy,0);
        }
        p[j+1]=p[j]+direction*r.Length; q[j]=AlignTangent(q[j],direction);
    }
}
void WriteNearGeometry(uint blade,uint pool,float3 p[NODES],float4 q[SEGMENTS])
{
    float3 root=BladesBuffer[blade].Root;
    [unroll] for(int s=0;s<7;s++)
    {
        float3 tangent=SafeNormal(p[s+1]-p[s],float3(0,1,0));
        float3 width=QRotate(q[s],float3(1,0,0));
        width=SafeNormal(width-tangent*dot(width,tangent),float3(1,0,0))*CompactRod(blade*7+s).HalfWidth;
        uint vertex=pool*15+s*2;
        ResultPosBuffer[vertex]=root+p[s]+width; ResultPosBuffer[vertex+1]=root+p[s]-width;
        float3 normal=SafeNormal(cross(width,tangent),float3(0,0,1));
        NormalBuffer[vertex]=normal; NormalBuffer[vertex+1]=normal;
    }
    ResultPosBuffer[pool*15+14]=root+p[7]; NormalBuffer[pool*15+14]=NormalBuffer[pool*15+13];
}

#include "GrassCompactEncode.cginc"
void WriteGeometry(uint blade,float3 p[8],float4 q[7])
{
    int pool=GridStates[blade/32].PoolOffset;
    if(pool>=0)WriteNearGeometry(blade,pool+blade%32,p,q);
    else WriteCompactPose(blade,p,q);
}
float4 FrameFromBasis(float3 x,float3 z)
{
    x=SafeNormal(x-z*dot(x,z),float3(1,0,0)); float3 y=cross(z,x); float4 q;
    float trace=x.x+y.y+z.z;
    if(trace>0) { float s=sqrt(trace+1)*2; q=float4((y.z-z.y)/s,(z.x-x.z)/s,(x.y-y.x)/s,s*.25); }
    else if(x.x>y.y && x.x>z.z)
    { float s=sqrt(max(1+x.x-y.y-z.z,1e-8))*2; q=float4(s*.25,(y.x+x.y)/s,(z.x+x.z)/s,(y.z-z.y)/s); }
    else if(y.y>z.z)
    { float s=sqrt(max(1+y.y-x.x-z.z,1e-8))*2; q=float4((y.x+x.y)/s,s*.25,(z.y+y.z)/s,(z.x-x.z)/s); }
    else { float s=sqrt(max(1+z.z-x.x-y.y,1e-8))*2; q=float4((z.x+x.z)/s,(z.y+y.z)/s,s*.25,(x.y-y.x)/s); }
    return QNormalize(q);
}
void ReadNearGeometry(uint blade,uint pool,out float3 p[8],out float4 q[7])
{
    float3 root=BladesBuffer[blade].Root; p[0]=0;
    [unroll] for(int n=1;n<7;n++)p[n]=(ResultPosBuffer[pool*15+n*2]+ResultPosBuffer[pool*15+n*2+1])*.5-root;
    p[7]=ResultPosBuffer[pool*15+14]-root;
    [unroll] for(int segment1=0;segment1<7;segment1++)q[segment1]=FrameFromBasis(ResultPosBuffer[pool*15+segment1*2]-ResultPosBuffer[pool*15+segment1*2+1],
        SafeNormal(p[segment1+1]-p[segment1],float3(0,1,0)));
}

int CompactInitialSeeding;
void ReadGeometry(uint blade,out float3 p[8],out float4 q[7])
{
    #if defined(COMPACT_NEAR_BIRTH)
        // Keep the accepted full-float basis reconstruction in a separate kernel.
        // Do not merge its arithmetic with the packed direction decoder.
        int pool=GridStates[blade/32].PoolOffset;
        ReadNearGeometry(blade,pool+blade%32,p,q);
    #else
    [unroll] for(uint n=0;n<8;n++)p[n]=CompactPosition(blade,n);
    [unroll] for(uint s=0;s<7;s++)q[s]=FrameFromBasis(CompactWidth(blade,s),SafeNormal(p[s+1]-p[s],float3(0,1,0)));
    #endif
}
float PlasticAmount(uint blade)
{
    float amount=0;
    if(EnablePlasticity!=0) [unroll] for(int segment2=0;segment2<7;segment2++)amount+=dot(CompactBend(blade*7+segment2).xy,CompactBend(blade*7+segment2).xy);
    return amount;
}
// Cold preparation is used when a grid first enters the warm band. Normal-speed entries
// subsequently acquire actual display velocities there, before they become physical.
// A discontinuous camera jump seeds the current geometry with an estimated motion instead.
void ReadColdState(uint blade,out float3 p[8],out float4 q[7],out float3 v[8],out float3 omega[7])
{
    ReadGeometry(blade,p,q);
    float3 now[8],previous[8]; float4 nowQ[7],previousQ[7];
    EvaluateCurve(blade,PoseTime,false,now,nowQ); EvaluateCurve(blade,PoseTime-PoseDt,true,previous,previousQ);
    bool lodged=PlasticAmount(blade)>1e-8; v[0]=0;
    [unroll] for(int segment3=0;segment3<7;segment3++)
    {
        omega[segment3]=QLog(QMul(nowQ[segment3],QInv(previousQ[segment3])))/max(PoseDt,1e-6);
        if(lodged)omega[segment3]*=min(1.0,LodgedAngularSpeed/max(length(omega[segment3]),1e-6));
        v[segment3+1]=v[segment3]+cross(omega[segment3],p[segment3+1]-p[segment3]);
    }
}
[numthreads(64,1,1)]
void ResetGeometry(uint3 id:SV_DispatchThreadID)
{
    uint blade=id.x; if(blade>=(uint)BladeCount)return;
    float3 p[8]; float4 q[7]; EvaluateCurve(blade,PoseTime,false,p,q); WriteGeometry(blade,p,q);
}
[numthreads(64,1,1)]
#if defined(COMPACT_NEAR_BIRTH)
void InitializeNearHistory(uint3 id:SV_DispatchThreadID)
#else
void InitializeHistory(uint3 id:SV_DispatchThreadID)
#endif
{
    if(id.x>=(uint)HistoryInitializationCount*32)return;
    int4 entry=HistoryInitializations[id.x/32]; uint blade=entry.y+id.x%32,cache=entry.x*32+id.x%32;
    #if defined(COMPACT_NEAR_BIRTH)
        if(GridStates[blade/32].PoolOffset<0)return;
    #else
        if(CompactInitialSeeding!=0 && GridStates[blade/32].PoolOffset>=0)return;
    #endif
    if(entry.z>=0)
    {
        uint pool=entry.z+id.x%32;
        [unroll] for(int node4=0;node4<8;node4++) { HistoryNodes[cache*8+node4]=BonesBuffer[pool*8+node4]; TransitionOffsets[cache*8+node4]=0; }
        [unroll] for(int segment5=0;segment5<7;segment5++) { HistoryFrames[cache*7+segment5]=FramesBuffer[pool*7+segment5]; TransitionRotations[cache*7+segment5]=float4(0,0,0,1); }
    }
    else
    {
        float3 p[8],v[8],omega[7]; float4 q[7]; ReadColdState(blade,p,q,v,omega);
        [unroll] for(int node6=0;node6<8;node6++)
        { BoneInfo node=CompactRest(blade*8+node6); node.Position=p[node6]; node.Predicted=p[node6]; node.Velocities=v[node6]; HistoryNodes[cache*8+node6]=node; TransitionOffsets[cache*8+node6]=0; }
        [unroll] for(int segment7=0;segment7<7;segment7++)
        { Frame frame; frame.Rotation=q[segment7]; frame.AngularVelocity=omega[segment7]; frame.Padding=0; HistoryFrames[cache*7+segment7]=frame; TransitionRotations[cache*7+segment7]=float4(0,0,0,1); }
    }
}
[numthreads(64,1,1)]
void CaptureTransition(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=(uint)ChangedCount*32)return;
    int2 entry=ChangedEntries[id.x/32]; uint blade=entry.y+id.x%32,cache=entry.x*32+id.x%32;
    // Preserve the outgoing visible pose before physical slots are reused.
    if(GridStates[blade/32].PoolOffset<0)
    {
        float3 oldP[8];float4 oldQ[7];
        [unroll] for(int n=0;n<8;n++)oldP[n]=HistoryNodes[cache*8+n].Position;
        [unroll] for(int s=0;s<7;s++)oldQ[s]=HistoryFrames[cache*7+s].Rotation;
        WriteCompactPose(blade,oldP,oldQ);
    }
    float3 p[8]; float4 q[7]; EvaluateCurve(blade,PoseTime,false,p,q);
    [unroll] for(int node8=0;node8<8;node8++)TransitionOffsets[cache*8+node8]=HistoryNodes[cache*8+node8].Position-p[node8];
    [unroll] for(int segment9=0;segment9<7;segment9++)TransitionRotations[cache*7+segment9]=QMul(HistoryFrames[cache*7+segment9].Rotation,QInv(q[segment9]));
}
[numthreads(64,1,1)]
void SeedSimulation(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=(uint)EntryCount*32)return;
    int2 entry=Entries[id.x/32]; uint blade=entry.y+id.x%32,pool=entry.x*32+id.x%32;
    uint cache=HistoryMap[blade/32].x*32+id.x%32;
    [unroll] for(int node10=0;node10<8;node10++)BonesBuffer[pool*8+node10]=HistoryNodes[cache*8+node10];
    [unroll] for(int segment11=0;segment11<7;segment11++)
    {
        FramesBuffer[pool*7+segment11]=HistoryFrames[cache*7+segment11];
        PlasticBendsBuffer[pool*7+segment11]=CompactBend(blade*7+segment11);
    }
    // Actual LOD entries need geometry before the first tick; birth/reset already
    // wrote the accepted float32 mesh. Do not reconstruct it a second time.
    if(CompactInitialSeeding==0)
    {
        float3 p[8];float4 q[7];
        [unroll] for(int n=0;n<8;n++)p[n]=HistoryNodes[cache*8+n].Position;
        [unroll] for(int s=0;s<7;s++)q[s]=HistoryFrames[cache*7+s].Rotation;
        WriteNearGeometry(blade,pool,p,q);
    }
}
[numthreads(64,1,1)]
void UpdateTieredDisplay(uint3 id:SV_DispatchThreadID)
{
    uint blade=id.x; if(blade>=(uint)BladeCount)return;
    GridState state=GridStates[blade/32]; int slot=HistoryMap[blade/32].x; uint cache=max(slot,0)*32+blade%32;
    uint pool=max(state.PoolOffset,0)+blade%32;
    bool liveExit=state.Padding==2 && state.PoolOffset>=0;
    float t=saturate((PoseTime-state.Started)/max(liveExit?ContactFadeSeconds:TransitionSeconds,.05)); t=t*t*(3-2*t);
    bool transitioning=state.Padding!=0 && (t<1 || liveExit);
    if(state.PoolOffset>=0 && !transitioning)
    {
        // The last XPBD substep already wrote the final visible geometry. No Bezier
        // evaluation, offset blending, normal rebuild or second geometry write here.
        if(slot>=0)
        {
            [unroll] for(int node12=0;node12<8;node12++)HistoryNodes[cache*8+node12]=CompactBonesRead[pool*8+node12];
            [unroll] for(int segment13=0;segment13<7;segment13++)HistoryFrames[cache*7+segment13]=CompactFramesRead[pool*7+segment13];
        }
        return;
    }
    float3 p[8]; float4 q[7]; EvaluateCurve(blade,PoseTime,false,p,q);
    if(liveExit)
    {
        // The solver keeps advancing independently; only the displayed ribbon fades.
        [unroll] for(int n=0;n<8;n++)p[n]=lerp(CompactBonesRead[pool*8+n].Position,p[n],t);
        p[0]=0;
        [unroll] for(int s=0;s<7;s++)
        {
            float3 direction=SafeNormal(p[s+1]-p[s],QRotate(q[s],float3(0,0,1)));
            p[s+1]=p[s]+direction*CompactRod(blade*7+s).Length;
            q[s]=AlignTangent(QBlend(CompactFramesRead[pool*7+s].Rotation,q[s],t),direction);
        }
    }
    else if(transitioning && slot>=0)
    {
        [unroll] for(int node14=0;node14<8;node14++)
        { float3 source=p[node14]+CompactOffsetsRead[cache*8+node14],target=p[node14]; if(state.PoolOffset>=0)target=CompactBonesRead[pool*8+node14].Position; p[node14]=lerp(source,target,t); }
        p[0]=0;
        [unroll] for(int segment15=0;segment15<7;segment15++)
        { float3 direction=SafeNormal(p[segment15+1]-p[segment15],QRotate(q[segment15],float3(0,0,1))); p[segment15+1]=p[segment15]+direction*CompactRod(blade*7+segment15).Length; }
        [unroll] for(int segment16=0;segment16<7;segment16++)
        {
            float4 source=QMul(CompactRotationsRead[cache*7+segment16],q[segment16]),target=q[segment16]; if(state.PoolOffset>=0)target=CompactFramesRead[pool*7+segment16].Rotation;
            q[segment16]=AlignTangent(QBlend(source,target,t),SafeNormal(p[segment16+1]-p[segment16],float3(0,1,0)));
        }
    }
    else
    {
        // Match the baseline's inextensible display projection even without a handoff.
        p[0]=0;
        [unroll] for(int segment17=0;segment17<7;segment17++)
        { float3 direction=SafeNormal(p[segment17+1]-p[segment17],QRotate(q[segment17],float3(0,0,1))); p[segment17+1]=p[segment17]+direction*CompactRod(blade*7+segment17).Length; q[segment17]=AlignTangent(q[segment17],direction); }
    }
    if(EnableBakedResponse!=0 && state.PoolOffset<0 && PlasticAmount(blade)>1e-8 && PoseDt>0)
    {
        float3 oldP[8]; float4 oldQ[7];
        if(slot<0)ReadGeometry(blade,oldP,oldQ);
        [unroll] for(int segment18=0;segment18<7;segment18++)
        {
            float4 previous=slot>=0?HistoryFrames[cache*7+segment18].Rotation:oldQ[segment18];
            float angle=length(QLog(QMul(q[segment18],QInv(previous)))); q[segment18]=QBlend(previous,q[segment18],min(1.0,LodgedAngularSpeed*PoseDt/max(angle,1e-6)));
        }
        p[0]=0;
        [unroll] for(int segment19=0;segment19<7;segment19++)
        { float len=CompactRod(blade*7+segment19).Length; float3 direction=GroundDirection(p[segment19],QRotate(q[segment19],float3(0,0,1)),len); p[segment19+1]=p[segment19]+direction*len; q[segment19]=AlignTangent(q[segment19],direction); }
    }
    if(slot>=0)
    {
        [unroll] for(int node20=0;node20<8;node20++)
        { BoneInfo node=HistoryNodes[cache*8+node20]; node.Velocities=(p[node20]-node.Position)/max(PoseDt,1e-6); node.Position=p[node20]; node.Predicted=p[node20]; HistoryNodes[cache*8+node20]=node; }
        [unroll] for(int segment21=0;segment21<7;segment21++)
        { Frame frame=HistoryFrames[cache*7+segment21]; frame.AngularVelocity=QLog(QMul(q[segment21],QInv(frame.Rotation)))/max(PoseDt,1e-6); frame.Rotation=q[segment21]; HistoryFrames[cache*7+segment21]=frame; }
    }
    WriteGeometry(blade,p,q);
}
// Diagnostics alone materialize world-sized nodes/frames. These buffers are temporary
// and are never allocated, dispatched or read by the normal simulation/render loop.
[numthreads(64,1,1)]
void DiagnosticSnapshot(uint3 id:SV_DispatchThreadID)
{
    uint blade=id.x; if(blade>=(uint)BladeCount)return;
    int slot=HistoryMap[blade/32].x; int poolOffset=GridStates[blade/32].PoolOffset;
    if(slot>=0)
    {
        uint cache=slot*32+blade%32;
        [unroll] for(int node22=0;node22<8;node22++)DiagnosticNodes[blade*8+node22]=HistoryNodes[cache*8+node22];
        [unroll] for(int segment23=0;segment23<7;segment23++)DiagnosticFrames[blade*7+segment23]=HistoryFrames[cache*7+segment23];
    }
    else if(poolOffset>=0)
    {
        uint pool=poolOffset+blade%32;
        [unroll] for(int node24=0;node24<8;node24++)DiagnosticNodes[blade*8+node24]=BonesBuffer[pool*8+node24];
        [unroll] for(int segment25=0;segment25<7;segment25++)DiagnosticFrames[blade*7+segment25]=FramesBuffer[pool*7+segment25];
    }
    else
    {
        float3 p[8],v[8],omega[7]; float4 q[7]; ReadColdState(blade,p,q,v,omega);
        [unroll] for(int node26=0;node26<8;node26++)
        { BoneInfo node=CompactRest(blade*8+node26); node.Position=p[node26]; node.Predicted=p[node26]; node.Velocities=v[node26]; DiagnosticNodes[blade*8+node26]=node; }
        [unroll] for(int segment27=0;segment27<7;segment27++)
        { Frame frame; frame.Rotation=q[segment27]; frame.AngularVelocity=omega[segment27]; frame.Padding=0; DiagnosticFrames[blade*7+segment27]=frame; }
    }
}

// Stream-only kernels: separate dispatches avoid binding wind state as SRV and UAV simultaneously.
[numthreads(64,1,1)]
void ResetWorldWind(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=(uint)RecycledCount)return;uint grid=RecycledGrids[id.x];
    float3 wind=QRotate(QInv(BakedYaw[grid]),SpatialWind(BakedGrids[grid].Position,PoseTime));
    BakedWindState[grid]=float4(wind.xz,0,0);PreviousWindState[grid]=float4(wind.xz,0,0);
}
[numthreads(64,1,1)]
void ResetWorldGeometry(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=(uint)(RecycledCount*32))return;uint blade=RecycledGrids[id.x/32]*32+id.x%32;
    float3 p[8];float4 q[7];EvaluateCurve(blade,PoseTime,false,p,q);WriteGeometry(blade,p,q);
}
